# Copy to .env.local and fill in. Without these, the app runs in DEMO mode
# (in-memory seed data, click-through sign-in) so dev/build work with no creds.

# From your Supabase project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# (optional) client-side mirror of the pool-admin allowlist, comma-separated.
# Controls who sees the "Pool" tab. Server still enforces independently.
# Defaults to connect@letsinterplay.com.
# VITE_IB_POOL_ADMIN_EMAILS=connect@letsinterplay.com

# ── Server-only vars (set these in Vercel → Project → Environment Variables,
#    NOT here — they must not be exposed to the browser) ───────────────────
# SUPABASE_SERVICE_ROLE_KEY=          # Supabase service_role / sb_secret_ key
# AIRTABLE_API_KEY=                   # Airtable PAT (data.records:read+write)
# AIRTABLE_BASE_ID=appONwRwGnRvhPgHc
# AIRTABLE_STAFF_TABLE=tblG0Wg94I837qbiT
# AIRTABLE_TIME_ENTRIES_TABLE=tbl5FWab23bnhepB4
# AIRTABLE_PAY_PERIODS_TABLE=tblielJsv6tfaxJ3c
# AIRTABLE_IB_LEDGER_TABLE=tbl6sR2OhP6PpGDn0
# CRON_SECRET=
# RESEND_API_KEY=                     # optional (redemption + low-stock emails)
# RESEND_FROM=Interplay <ib@letsinterplay.com>
# IB_POOL_REDEMPTION_ENABLED=false    # flip to "true" to turn on the pool picker
# IB_POOL_ADMIN_EMAILS=connect@letsinterplay.com
