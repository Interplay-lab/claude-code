{
  "name": "Auto-link Time Entries to Pay Periods (nightly)",
  "flow": [
    {
      "id": 1,
      "module": "airtable:ActionSearchRecords",
      "version": 3,
      "mapper": {
        "base": "appONwRwGnRvhPgHc",
        "table": "tbl5FWab23bnhepB4",
        "formula": "AND(LEN({Pay Period} & '') = 0, IS_AFTER({Start}, DATEADD(NOW(), -60, 'days')))",
        "maxRecords": 500,
        "useColumnId": false
      },
      "parameters": {"__IMTCONN__": 8741307},
      "metadata": {"designer": {"x": 0, "y": 0}}
    },
    {
      "id": 2,
      "module": "airtable:ActionSearchRecords",
      "version": 3,
      "mapper": {
        "base": "appONwRwGnRvhPgHc",
        "table": "tblielJsv6tfaxJ3c",
        "formula": "AND(FIND('{{1.fldzRyHOyY3ocVKuB[].id}}', ARRAYJOIN({fldrqvgbLMSMTMbVC}, ',')) > 0, DATETIME_DIFF('{{formatDate(1.fldhdPbYSruwgNx1v; \"YYYY-MM-DD\")}}', {fldRehAOKGKueyKAC}, 'days') >= 0, DATETIME_DIFF({fldf9FvqvmyywkRz3}, '{{formatDate(1.fldhdPbYSruwgNx1v; \"YYYY-MM-DD\")}}', 'days') >= 0)",
        "maxRecords": 1,
        "useColumnId": true
      },
      "parameters": {"__IMTCONN__": 8741307},
      "metadata": {"designer": {"x": 300, "y": 0}}
    },
    {
      "id": 3,
      "module": "airtable:ActionUpdateRecord",
      "version": 3,
      "filter": {
        "name": "Pay Period found",
        "conditions": [
          [{"a": "{{length(2.id)}}", "b": "0", "o": "number:notequal"}]
        ]
      },
      "mapper": {
        "base": "appONwRwGnRvhPgHc",
        "table": "tbl5FWab23bnhepB4",
        "id": "{{1.id}}",
        "record": {
          "fldv6FnfintjARY2m": ["{{2.id}}"]
        },
        "typecast": true,
        "useColumnId": true
      },
      "parameters": {"__IMTCONN__": 8741307},
      "metadata": {"designer": {"x": 600, "y": 0}}
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "designer": {"orphans": []},
    "scenario": {
      "dlq": false,
      "dataloss": false,
      "maxErrors": 3,
      "autoCommit": true,
      "roundtrips": 1,
      "sequential": false,
      "confidential": false,
      "freshVariables": false,
      "autoCommitTriggerLast": true
    },
    "scheduling": {
      "type": "indefinitely",
      "interval": 86400,
      "start": "2026-06-23T09:00:00.000Z"
    }
  }
}
